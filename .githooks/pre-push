#!/bin/sh
# Refuse a push whose tree or new commit messages contain a private term
# (client names and the like). The list lives OUTSIDE this public repo on
# purpose: committing it would publish the names it protects.
# ci.yml is skipped: it must spell the method vocabulary to grep for it.
# Enable once per clone: git config core.hooksPath .githooks
terms="${TOWNSEND_PRIVATE_TERMS:-$HOME/Documents/townsend-ai-studio-workspace/private-terms.txt}"
if [ ! -s "$terms" ]; then
  echo "pre-push: no private-terms list at $terms; skipping the client-name check" >&2
  exit 0
fi
clean=$(mktemp "${TMPDIR:-/tmp}/private-terms.XXXXXX")
trap 'rm -f "$clean"' EXIT
grep -v -e '^[[:space:]]*#' -e '^[[:space:]]*$' "$terms" > "$clean" || true
[ -s "$clean" ] || exit 0
zero=0000000000000000000000000000000000000000
status=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue
  if hits=$(git grep -n -i -F -f "$clean" "$local_sha" -- . ':!LICENSE' ':!.github/workflows/ci.yml'); then
    echo "pre-push: private term in the tree of $local_ref:" >&2
    echo "$hits" >&2
    status=1
  fi
  if [ "$remote_sha" = "$zero" ]; then range="$local_sha --not --remotes"; else range="$remote_sha..$local_sha"; fi
  # shellcheck disable=SC2086
  if msgs=$(git log --format='%h %B' $range | grep -i -F -f "$clean"); then
    echo "pre-push: private term in a commit message on $local_ref:" >&2
    echo "$msgs" >&2
    status=1
  fi
done
[ $status -ne 0 ] && echo "pre-push: refused. Rename, reword (git commit --amend / rebase), then push again." >&2
exit $status
